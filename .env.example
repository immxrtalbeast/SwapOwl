# Скопируйте в .env и подставьте свои значения. Реальные секреты в репозиторий не попадают.
# Переменные описаны в спецификация, раздел 7.6.

# --- PostgreSQL (сервис postgres в docker compose) ---
POSTGRES_USER=umirhack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=umirhack

# --- API ---
# В docker compose DATABASE_URL собирается из POSTGRES_*; это значение нужно для запуска без compose.
DATABASE_URL=postgres://umirhack:change-me@localhost:5432/umirhack?sslmode=disable
API_PORT=8080
RESTAURANT_TZ=Europe/Moscow
OPEN_AT=10:00
CLOSE_AT=23:00
LOG_LEVEL=info
DB_POOL_SIZE=20
CLOCK_MODE=real
# Локально, без входа; на сервере — true и ADMIN_LOGIN/ADMIN_PASSWORD.
AUTH_REQUIRED=false
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Фото накладной (FS-158): ключ Claude; без ключа на демо-стенде работает демо-распознаватель с образцом.
ANTHROPIC_API_KEY=
INVOICE_MODEL=claude-haiku-5-5
INVOICE_PER_HOUR=30
