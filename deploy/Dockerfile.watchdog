# Сторож доступности (FS-117). Сборка из корня репозитория: docker build -f deploy/Dockerfile.watchdog .
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/watchdog ./cmd/watchdog

FROM alpine:3.20
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 app
USER app
COPY --from=build /out/watchdog /usr/local/bin/watchdog
ENTRYPOINT ["/usr/local/bin/watchdog"]
