# Прод-окружение. На сервере копия лежит в /opt/swapowl/.env (права 600), значения секретов подставляют люди.
SITE_DOMAIN=localhost
IMAGE_TAG=latest
IMAGE_REPO=ghcr.io/immxrtalbeast/umirhack-2026

POSTGRES_USER=umirhack
POSTGRES_PASSWORD=
POSTGRES_DB=umirhack

ADMIN_LOGIN=admin
ADMIN_PASSWORD=
DEMO_TOKEN=
AUTH_REQUIRED=false
DEMO_MODE=true
SEED_ON_EMPTY=true
LATE_EVENTS_HOURS=2
CLOCK_MODE=real
DB_POOL_SIZE=5
RESTAURANT_TZ=Europe/Moscow
LOG_LEVEL=info
METRICS_TOKEN=

# Ключ интеграции (Bearer) для адаптера и notifier: выпускается в API после первого запуска.
# Пока пусто — iiko-adapter и notifier будут перезапускаться, это нормально.
ADAPTER_API_KEY=
IIKO_LOGIN=demo
IIKO_PASSWORD=
ADAPTER_MODE=shadow
NOTIFIER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
