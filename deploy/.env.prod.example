# Прод-окружение. На сервере копия лежит в /opt/swapowl/.env (права 600), значения секретов подставляют люди.
SITE_DOMAIN=localhost
IMAGE_TAG=latest
IMAGE_REPO=ghcr.io/immxrtalbeast/umirhack-2026

POSTGRES_USER=umirhack
POSTGRES_PASSWORD=
POSTGRES_DB=umirhack

ADMIN_LOGIN=admin
ADMIN_PASSWORD=
DEMO_TOKEN=
AUTH_REQUIRED=false
DEMO_MODE=true
SEED_ON_EMPTY=true
LATE_EVENTS_HOURS=2
CLOCK_MODE=real
DB_POOL_SIZE=5
RESTAURANT_TZ=Europe/Moscow
LOG_LEVEL=info
METRICS_TOKEN=

# Профили compose. Пусто — демо-стенд без интеграций: caddy, web, api, postgres.
# integrations включает fake-iiko, iiko-adapter и notifier; только на отдельной точке со своей БД
# (адаптер заливает в БД справочники и продажи эмулятора с реальными часами и портит демо-сид).
COMPOSE_PROFILES=

# Ключ интеграции (Bearer) для адаптера и notifier: выпускается в API после первого запуска.
# Нужны только с COMPOSE_PROFILES=integrations; без ключа iiko-adapter и notifier перезапускаются в цикле.
ADAPTER_API_KEY=
IIKO_LOGIN=demo
IIKO_PASSWORD=
ADAPTER_MODE=shadow
NOTIFIER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Лимиты памяти (по умолчанию — для одной точки; для многих точек см. docs/operations.md).
CADDY_MEM=128m
WEB_MEM=64m
API_MEM=256m
PG_MEM=512m
SIDECAR_MEM=64m

# Сторож (профиль ops) и сеть точек (профиль fleet; пишет fleet.sh в edge/.env).
WATCHDOG_TG_TOKEN=
WATCHDOG_TG_CHAT=
HUB_TOKEN=
